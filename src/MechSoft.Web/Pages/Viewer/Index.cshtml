@page "/Viewer"
@model MechSoft.Web.Pages.Viewer.IndexModel
@{
    ViewData["Title"] = "eDrawings Viewer";
    if (Model.OpenFile is { } open && Model.Files.Any(f => f.Id == open))
    {
        ViewData["AutoLoadId"] = open;
    }

    // Files are listed by folder: a header row whenever the folder path changes, then the files in it.
    var ordered = Model.Files
        .OrderBy(f => f.FileName.Contains('/') ? 1 : 0)
        .ThenBy(f => f.FileName.Contains('/') ? f.FileName[..f.FileName.LastIndexOf('/')] : "", StringComparer.OrdinalIgnoreCase)
        .ThenBy(f => f.FileName, StringComparer.OrdinalIgnoreCase)
        .ToList();
    string currentFolder = "";
}

<div class="space-y-4">
    <div>
        <h1 class="text-xl font-semibold text-slate-900">eDrawings Viewer</h1>
        <p class="text-sm text-slate-500">Upload files or whole folders to the shared file library, then preview 3D models.</p>
    </div>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="rounded-md border border-emerald-200 bg-emerald-50 px-4 py-2 text-sm text-emerald-800">@Model.Message</div>
    }
    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="rounded-md border border-red-200 bg-red-50 px-4 py-2 text-sm text-red-700">@Model.Error</div>
    }

    <div>
        <!-- File library -->
        <div class="overflow-hidden rounded-lg border border-slate-200 bg-white">
            <div class="space-y-2 border-b border-slate-200 px-4 py-3">
                <div class="flex items-center justify-between">
                    <div class="text-xs font-semibold uppercase text-slate-500">File Library <span class="ml-1 font-normal normal-case text-slate-400">(@Model.Files.Count)</span></div>
                </div>
                <form method="post" asp-page-handler="Upload" enctype="multipart/form-data" id="cadUploadForm" class="flex flex-wrap items-center gap-2">
                    <label class="cursor-pointer rounded-md bg-blue-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-blue-700">
                        Upload files
                        <input type="file" multiple class="hidden" data-upload-input />
                    </label>
                    <label class="cursor-pointer rounded-md border border-blue-600 px-3 py-1.5 text-xs font-semibold text-blue-700 hover:bg-blue-50">
                        Upload folder
                        <input type="file" webkitdirectory directory multiple class="hidden" data-upload-input />
                    </label>
                    <span id="uploadStatus" class="hidden text-xs text-slate-500"></span>
                </form>
                <div class="text-[11px] text-slate-400">Saved on the server &mdash; everyone using this application can open them.@(Model.ApsConfigured ? " SolidWorks, DWG, Inventor and other proprietary formats are previewed through Autodesk." : "")</div>
                <form method="get" class="flex gap-2">
                    <input type="text" name="Search" value="@Model.Search" placeholder="Filter files and folders..."
                           class="w-full rounded-md border border-slate-200 px-3 py-1.5 text-sm focus:border-sky-500 focus:outline-none focus:ring-1 focus:ring-sky-500" />
                    <button type="submit" class="rounded-md border border-slate-200 px-3 py-1.5 text-sm text-slate-600 hover:bg-slate-50">Search</button>
                    @if (!string.IsNullOrWhiteSpace(Model.Search))
                    {
                        <a href="/Viewer" class="px-2 py-1.5 text-sm text-slate-500 hover:underline">Clear</a>
                    }
                </form>
            </div>

            <div class="max-h-[32rem] overflow-y-auto divide-y divide-slate-100">
                @foreach (var f in ordered)
                {
                    var slash = f.FileName.LastIndexOf('/');
                    var folder = slash >= 0 ? f.FileName[..slash] : "";
                    var baseName = slash >= 0 ? f.FileName[(slash + 1)..] : f.FileName;
                    if (folder != currentFolder)
                    {
                        currentFolder = folder;
                        <div class="bg-slate-50 px-4 py-1.5 text-xs font-semibold text-slate-600">&#128193; @folder</div>
                    }
                    <div class="flex items-center justify-between gap-2 py-2 pr-3 text-sm @(folder != "" ? "pl-8" : "pl-4") @(Model.OpenFile == f.Id ? "bg-sky-50" : "")">
                        <div class="min-w-0">
                            <button type="button" data-file-id="@f.Id" data-cad-open="@Url.Page("Index", "Download", new { id = f.Id })" data-cad-name="@baseName"
                                    data-cad-ext="@f.Extension" data-cad-size="@f.SizeBytes" data-aps-status="@f.ApsStatus" data-aps-urn="@f.ApsUrn"
                                    data-aps-status-url="@Url.Page("Index", "ApsStatus", new { id = f.Id })"
                                    class="block max-w-full truncate text-left font-medium text-sky-700 hover:underline" title="@f.FileName">@baseName</button>
                            <div class="text-xs text-slate-400">@f.Extension.ToUpperInvariant() &middot; @((f.SizeBytes / 1024.0).ToString("N1")) KB
                                @if (!MechSoft.Web.Pages.Viewer.IndexModel.IsNative(f.Extension))
                                {
                                    if (f.ApsStatus == "success") { <span class="ml-1 rounded bg-emerald-50 px-1.5 py-0.5 text-emerald-700">Autodesk preview ready</span> }
                                    else if (f.ApsStatus == "pending") { <span class="ml-1 rounded bg-amber-50 px-1.5 py-0.5 text-amber-700">Autodesk translating...</span> }
                                    else if (f.ApsStatus == "failed") { <span class="ml-1 rounded bg-red-50 px-1.5 py-0.5 text-red-700">Autodesk could not translate this file</span> }
                                }
                            </div>
                        </div>
                        <div class="flex shrink-0 flex-wrap items-center justify-end gap-x-3 gap-y-1 text-xs">
                            @if (Model.ApsConfigured && !MechSoft.Web.Pages.Viewer.IndexModel.IsNative(f.Extension) && f.ApsStatus is null or "failed")
                            {
                                <form method="post" asp-page-handler="Translate" asp-route-id="@f.Id">
                                    <button type="submit" class="text-sky-700 hover:underline">@(f.ApsStatus == "failed" ? "Retry" : "Preview") via Autodesk</button>
                                </form>
                            }
                            <a href="@Url.Page("Index", "Download", new { id = f.Id })" class="text-slate-600 hover:underline">Download</a>
                            <form method="post" asp-page-handler="Delete" asp-route-id="@f.Id" x-data="{ confirming: false }" class="flex items-center gap-2">
                                <button type="button" x-show="!confirming" @@click="confirming = true" class="text-red-600 hover:underline">Delete</button>
                                <span x-show="confirming" x-cloak class="flex items-center gap-2">
                                    <span class="text-slate-500">Delete for everyone?</span>
                                    <button type="submit" class="font-semibold text-red-600 hover:underline">Yes, delete</button>
                                    <button type="button" @@click="confirming = false" class="text-slate-500 hover:underline">Cancel</button>
                                </span>
                            </form>
                        </div>
                    </div>
                }
                @if (!Model.Files.Any())
                {
                    <div class="px-4 py-10 text-center text-sm text-slate-400">
                        @(string.IsNullOrWhiteSpace(Model.Search) ? "The library is empty. Use Upload files or Upload folder above." : "No files match your search.")
                    </div>
                }
            </div>
        </div>

        <!-- Full-screen 3D viewer popup (hidden until a file is opened) -->
        <partial name="_ViewerPanel" view-data="ViewData" />
    </div>
</div>

<script>
    // Files and folders are posted with fetch so each file keeps its folder path
    // (webkitRelativePath) as its name; the server saves every file to the library.
    (function () {
        const form = document.getElementById("cadUploadForm");
        if (!form) return;
        const status = document.getElementById("uploadStatus");
        form.querySelectorAll("[data-upload-input]").forEach(input => {
            input.addEventListener("change", async () => {
                const files = Array.from(input.files || []);
                if (!files.length) return;
                const data = new FormData();
                data.append("__RequestVerificationToken", form.querySelector("input[name=__RequestVerificationToken]").value);
                files.forEach(f => data.append("uploads", f, f.webkitRelativePath || f.name));
                status.textContent = "Uploading " + files.length + " file" + (files.length === 1 ? "" : "s") + "...";
                status.classList.remove("hidden");
                try {
                    const res = await fetch(form.action, { method: "POST", body: data });
                    window.location.href = res.url;
                } catch (e) {
                    status.textContent = "Upload failed. Check your connection and try again.";
                }
            });
        });
    })();
</script>
