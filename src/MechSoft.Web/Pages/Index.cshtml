@page "/"
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
    var s = Model.Dashboard.Stats;
    var ps = Model.Dashboard.ProjectSummary;

    string BarColor(int pct) => pct >= 100 ? "bg-emerald-500" : pct >= 60 ? "bg-sky-500" : pct >= 30 ? "bg-amber-500" : "bg-slate-400";

    string DaysLabel(DateTime? target, ProjectStatus status)
    {
        if (status == ProjectStatus.Completed) return "Completed";
        if (target is null) return "No target date";
        var days = (target.Value.Date - DateTime.Today).Days;
        if (days < 0) return $"{-days} day{(days == -1 ? "" : "s")} overdue";
        if (days == 0) return "Due today";
        return $"{days} day{(days == 1 ? "" : "s")} left";
    }
}

<div class="space-y-6">
    <div>
        <h1 class="text-xl font-semibold text-slate-900">Dashboard</h1>
        <p class="text-sm text-slate-500">Plant-wide inventory and document overview.</p>
    </div>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-lg border border-slate-200 bg-white p-4">
            <div class="flex items-center gap-3">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-sky-50 text-sky-600 ring-1 ring-inset ring-sky-600/10">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375C2.754 3.75 2.25 4.254 2.25 4.875v1.5c0 .621.504 1.125 1.125 1.125z" /></svg>
                </div>
                <div>
                    <div class="text-xs font-medium text-slate-500">Active SKUs</div>
                    <div class="text-2xl font-semibold text-slate-900">@s.ActiveSkuCount</div>
                </div>
            </div>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-4">
            <div class="flex items-center gap-3">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-amber-50 text-amber-600 ring-1 ring-inset ring-amber-600/10">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" /></svg>
                </div>
                <div>
                    <div class="text-xs font-medium text-slate-500">Low / Out of Stock</div>
                    <div class="text-2xl font-semibold text-amber-600">@s.LowOrOutOfStockCount</div>
                </div>
            </div>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-4">
            <div class="flex items-center gap-3">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-violet-50 text-violet-600 ring-1 ring-inset ring-violet-600/10">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.218c1.121-2.3 1.994-4.705 2.602-7.189.077-.316-.164-.611-.49-.611H5.106M7.5 14.25L5.106 5.272M6 20.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm12.75 0a.75.75 0 11-1.5 0 .75.75 0 011.5 0z" /></svg>
                </div>
                <div>
                    <div class="text-xs font-medium text-slate-500">Open Purchase Orders</div>
                    <div class="text-2xl font-semibold text-slate-900">@s.OpenPurchaseOrderCount</div>
                </div>
            </div>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-4">
            <div class="flex items-center gap-3">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-emerald-50 text-emerald-600 ring-1 ring-inset ring-emerald-600/10">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.84H14.25M16.5 18.75h-2.25m0-11.177v11.177m0-11.177L12 4.5m2.25 3.073L9 4.5m0 0L5.106 7.573m3.894-3.073v11.177m0 0H5.25m3.75 0h3" /></svg>
                </div>
                <div>
                    <div class="text-xs font-medium text-slate-500">Delivery Challans</div>
                    <div class="text-2xl font-semibold text-slate-900">@s.DeliveryChallanCount</div>
                </div>
            </div>
        </div>
    </div>

    <div class="rounded-lg border border-slate-200 bg-white">
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 px-4 py-3">
            <h2 class="text-sm font-semibold text-slate-900">Project Details &mdash; machine builds going on</h2>
            <a href="/Projects" class="text-xs font-medium text-sky-700 hover:underline">View all projects &rarr;</a>
        </div>

        <div class="grid grid-cols-2 gap-3 border-b border-slate-200 px-4 py-3 sm:grid-cols-4">
            <div>
                <div class="text-xs text-slate-500">Ongoing</div>
                <div class="text-xl font-semibold text-sky-700">@ps.OngoingCount</div>
            </div>
            <div>
                <div class="text-xs text-slate-500">On Hold</div>
                <div class="text-xl font-semibold text-amber-600">@ps.OnHoldCount</div>
            </div>
            <div>
                <div class="text-xs text-slate-500">Completed</div>
                <div class="text-xl font-semibold text-emerald-700">@ps.CompletedCount</div>
            </div>
            <div>
                <div class="text-xs text-slate-500">Avg. completion (ongoing)</div>
                <div class="text-xl font-semibold text-slate-900">@ps.AverageCompletion.ToString("F0")%</div>
            </div>
        </div>

        <div class="divide-y divide-slate-100">
            @foreach (var p in Model.Dashboard.OngoingProjects)
            {
                <a href="@Url.Page("/Projects/Index", new { selectedId = p.Id })" class="block px-4 py-3 hover:bg-slate-50">
                    <div class="flex flex-wrap items-center justify-between gap-2">
                        <div class="flex min-w-0 items-center gap-2">
                            @if (p.HasPhoto)
                            {
                                <img src="@Url.Page("/Projects/Index", "Photo", new { id = p.Id })" alt="" class="h-8 w-8 shrink-0 rounded object-cover ring-1 ring-slate-200" />
                            }
                            else
                            {
                                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded bg-slate-100 text-xs text-slate-400 ring-1 ring-slate-200">&#128247;</span>
                            }
                            <div class="min-w-0">
                                <div class="truncate text-sm font-medium text-slate-900">@p.Name</div>
                                <div class="truncate text-xs text-slate-500">@p.MachineType &middot; @p.CustomerName</div>
                            </div>
                        </div>
                        <div class="flex shrink-0 items-center gap-2">
                            <partial name="_ProjectStatusBadge" model="p.Status" />
                            <span class="text-xs text-slate-500">@DaysLabel(p.TargetDate, p.Status)</span>
                        </div>
                    </div>
                    <div class="mt-2 flex items-center gap-2">
                        <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-slate-100">
                            <div class="@BarColor(p.CompletionPercent) h-full rounded-full" style="width:@p.CompletionPercent%"></div>
                        </div>
                        <span class="w-10 shrink-0 text-right text-xs font-medium text-slate-700">@p.CompletionPercent%</span>
                    </div>
                </a>
            }
            @if (!Model.Dashboard.OngoingProjects.Any())
            {
                <div class="px-4 py-6 text-center text-sm text-slate-400">No projects in progress. <a href="/Projects" class="text-sky-700 hover:underline">Add one</a>.</div>
            }
        </div>
    </div>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
        <div class="lg:col-span-2 rounded-lg border border-slate-200 bg-white">
            <div class="border-b border-slate-200 px-4 py-3">
                <h2 class="text-sm font-semibold text-slate-900">Inventory requiring attention</h2>
            </div>
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-slate-200 text-sm">
                    <thead class="bg-slate-50 text-xs uppercase text-slate-500">
                        <tr>
                            <th class="px-4 py-2 text-left">SKU</th>
                            <th class="px-4 py-2 text-left">Name</th>
                            <th class="px-4 py-2 text-left">Stock</th>
                            <th class="px-4 py-2 text-left">Status</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var p in Model.Dashboard.PartsRequiringAttention)
                        {
                            <tr class="hover:bg-slate-50">
                                <td class="px-4 py-2 font-medium text-slate-900">@p.Sku</td>
                                <td class="px-4 py-2 text-slate-700">@p.Name</td>
                                <td class="px-4 py-2 text-slate-700">@p.Stock</td>
                                <td class="px-4 py-2"><partial name="_StockBadge" model="p.Status" /></td>
                            </tr>
                        }
                        @if (!Model.Dashboard.PartsRequiringAttention.Any())
                        {
                            <tr><td colspan="4" class="px-4 py-6 text-center text-slate-400">All parts are in stock.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="rounded-lg border border-slate-200 bg-white">
            <div class="border-b border-slate-200 px-4 py-3">
                <h2 class="text-sm font-semibold text-slate-900">Recent documents</h2>
            </div>
            <ul class="divide-y divide-slate-100">
                @foreach (var d in Model.Dashboard.RecentDocuments)
                {
                    <li class="flex items-center justify-between px-4 py-3">
                        <div>
                            <div class="text-sm font-medium text-slate-900">@d.Id</div>
                            <div class="text-xs text-slate-500">@d.Kind &middot; @d.CounterpartyName</div>
                        </div>
                        <div class="text-right">
                            <div class="text-sm font-medium text-slate-900">@CurrencyFormatter.Format(d.Value)</div>
                            <div class="text-xs text-slate-500">@d.Date.ToString("dd MMM yyyy")</div>
                        </div>
                    </li>
                }
                @if (!Model.Dashboard.RecentDocuments.Any())
                {
                    <li class="px-4 py-6 text-center text-sm text-slate-400">No recent documents.</li>
                }
            </ul>
        </div>
    </div>
</div>
