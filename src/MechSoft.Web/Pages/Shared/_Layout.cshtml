@{
    string CurrentPath = Context.Request.Path.Value ?? "/";
    bool IsActive(string path) => path == "/"
        ? CurrentPath == "/" || CurrentPath.StartsWith("/Index", StringComparison.OrdinalIgnoreCase)
        : CurrentPath.StartsWith(path, StringComparison.OrdinalIgnoreCase);
    string NavClass(string path) => IsActive(path)
        ? "nav-link nav-link-active"
        : "nav-link nav-link-inactive";

    // Heroicons (outline, 24x24, stroke-based) inlined so the sidebar needs no extra request.
    string IconFor(string path) => path switch
    {
        "/" => "<path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M3.75 12l8.25-8.25L20.25 12M4.5 9.75V20.25a.75.75 0 00.75.75h4.5v-6h4.5v6h4.5a.75.75 0 00.75-.75V9.75\" />",
        "/Inventory" => "<path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M3.75 7.5l8.25-4.5 8.25 4.5m-16.5 0v9l8.25 4.5m-8.25-13.5l8.25 4.5m0 9l8.25-4.5m-8.25 4.5v-9m8.25 4.5v-9m0 0L12 7.5\" />",
        "/Products" => "<path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M9.568 3H5.25A2.25 2.25 0 003 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 005.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 009.568 3z\" /><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M6 6h.008v.008H6V6z\" />",
        "/Projects" => "<path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z\" />",
        "/Viewer" => "<path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M21 7.5l-9-5.25L3 7.5m18 0l-9 5.25M21 7.5v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9\" />",
        "/PurchaseOrders" => "<path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.218c1.121-2.3 1.994-4.705 2.602-7.189.077-.316-.164-.611-.49-.611H5.106M7.5 14.25L5.106 5.272M6 20.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm12.75 0a.75.75 0 11-1.5 0 .75.75 0 011.5 0z\" />",
        "/DeliveryChallans" => "<path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.84H14.25M16.5 18.75h-2.25m0-11.177v11.177m0-11.177L12 4.5m2.25 3.073L9 4.5m0 0L5.106 7.573m3.894-3.073v11.177m0 0H5.25m3.75 0h3\" />",
        "/Billing" => "<path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5h-15A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5z\" />",
        "/Quotes" => "<path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z\" />",
        _ => "<path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M9 12l2 2 4-4\" />",
    };
    string NavIcon(string path) => $"<svg class=\"nav-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" aria-hidden=\"true\">{IconFor(path)}</svg>";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - MechSoft Inventory</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="~/js/line-editor.js" asp-append-version="true"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.1/dist/cdn.min.js"></script>
</head>
<body class="h-full bg-slate-50 text-slate-900">
    <div class="flex h-screen overflow-hidden">
        <!-- Sidebar (desktop) -->
        <aside class="app-sidebar hidden md:flex md:w-64 md:flex-col text-white">
            <div class="flex items-center gap-3 px-5 py-5 border-b border-white/10">
                <div class="brand-mark flex h-10 w-10 items-center justify-center rounded-xl font-bold text-white">F</div>
                <div>
                    <div class="text-sm font-semibold leading-tight tracking-tight">Ferrowatt PLM</div>
                    <div class="text-[11px] text-slate-400 leading-tight">Manufacturing Inventory</div>
                </div>
            </div>
            <nav class="flex-1 space-y-1 overflow-y-auto px-3 py-4">
                <a class="@NavClass("/")" href="/">
                    @Html.Raw(NavIcon("/"))
                    <span>Dashboard</span>
                </a>
                <a class="@NavClass("/Inventory")" href="/Inventory">
                    @Html.Raw(NavIcon("/Inventory"))
                    <span>Inventory</span>
                </a>
                <a class="@NavClass("/Products")" href="/Products">
                    @Html.Raw(NavIcon("/Products"))
                    <span>Product Details</span>
                </a>
                <a class="@NavClass("/Projects")" href="/Projects">
                    @Html.Raw(NavIcon("/Projects"))
                    <span>Projects</span>
                </a>
                <a class="@NavClass("/Viewer")" href="/Viewer">
                    @Html.Raw(NavIcon("/Viewer"))
                    <span>eDrawings Viewer</span>
                </a>
                <a class="@NavClass("/PurchaseOrders")" href="/PurchaseOrders">
                    @Html.Raw(NavIcon("/PurchaseOrders"))
                    <span>Purchase Orders</span>
                </a>
                <a class="@NavClass("/DeliveryChallans")" href="/DeliveryChallans">
                    @Html.Raw(NavIcon("/DeliveryChallans"))
                    <span>Delivery Challans</span>
                </a>
                <a class="@NavClass("/Billing")" href="/Billing">
                    @Html.Raw(NavIcon("/Billing"))
                    <span>Billing</span>
                </a>
                <a class="@NavClass("/Quotes")" href="/Quotes">
                    @Html.Raw(NavIcon("/Quotes"))
                    <span>Quote Preparation</span>
                </a>
            </nav>
            <div class="px-4 py-4 border-t border-white/10">
                <div class="flex items-center gap-2 rounded-lg bg-white/5 px-3 py-2 text-xs text-emerald-400 ring-1 ring-white/10">
                    <span class="relative flex h-2 w-2">
                        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
                        <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-400"></span>
                    </span>
                    Plant Floor Sync &mdash; Online
                </div>
            </div>
        </aside>

        <div class="flex flex-1 flex-col overflow-hidden">
            <!-- Header -->
            <header class="no-print app-header flex items-center justify-between px-4 py-3 md:px-6">
                <div class="hidden md:block w-full max-w-md">
                    <div class="relative">
                        <input type="text" placeholder="Search parts, orders, documents..."
                               class="w-full rounded-full border border-slate-200 bg-slate-50 py-2 pl-9 pr-3 text-sm text-slate-700 transition focus:border-sky-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-sky-100" />
                        <svg class="pointer-events-none absolute left-3 top-2.5 h-4 w-4 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M19 11a8 8 0 11-16 0 8 8 0 0116 0z" />
                        </svg>
                    </div>
                </div>
                <div class="flex items-center gap-4 ml-auto">
                    <button class="relative rounded-full p-2 text-slate-500 transition hover:bg-slate-100 hover:text-slate-700" aria-label="Notifications">
                        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0" />
                        </svg>
                        <span class="absolute right-1.5 top-1.5 h-2 w-2 rounded-full bg-rose-500 ring-2 ring-white"></span>
                    </button>
                    <div class="flex items-center gap-2 border-l border-slate-200 pl-4">
                        <div class="avatar-chip flex h-9 w-9 items-center justify-center rounded-full text-xs font-semibold text-white">RK</div>
                        <div class="hidden sm:block leading-tight">
                            <div class="text-sm font-medium text-slate-900">R. Kannan</div>
                            <div class="text-[11px] text-slate-500">Inventory Controller</div>
                        </div>
                    </div>
                </div>
            </header>

            <!-- Mobile pill nav -->
            <nav class="no-print md:hidden flex gap-2 overflow-x-auto border-b border-slate-200 bg-white px-3 py-2">
                <a class="whitespace-nowrap rounded-full px-3 py-1.5 text-xs font-medium transition @(IsActive("/") ? "bg-sky-600 text-white shadow-sm shadow-sky-600/30" : "bg-slate-100 text-slate-600")" href="/">Dashboard</a>
                <a class="whitespace-nowrap rounded-full px-3 py-1.5 text-xs font-medium transition @(IsActive("/Inventory") ? "bg-sky-600 text-white shadow-sm shadow-sky-600/30" : "bg-slate-100 text-slate-600")" href="/Inventory">Inventory</a>
                <a class="whitespace-nowrap rounded-full px-3 py-1.5 text-xs font-medium transition @(IsActive("/Products") ? "bg-sky-600 text-white shadow-sm shadow-sky-600/30" : "bg-slate-100 text-slate-600")" href="/Products">Product Details</a>
                <a class="whitespace-nowrap rounded-full px-3 py-1.5 text-xs font-medium transition @(IsActive("/Projects") ? "bg-sky-600 text-white shadow-sm shadow-sky-600/30" : "bg-slate-100 text-slate-600")" href="/Projects">Projects</a>
                <a class="whitespace-nowrap rounded-full px-3 py-1.5 text-xs font-medium transition @(IsActive("/Viewer") ? "bg-sky-600 text-white shadow-sm shadow-sky-600/30" : "bg-slate-100 text-slate-600")" href="/Viewer">eDrawings</a>
                <a class="whitespace-nowrap rounded-full px-3 py-1.5 text-xs font-medium transition @(IsActive("/PurchaseOrders") ? "bg-sky-600 text-white shadow-sm shadow-sky-600/30" : "bg-slate-100 text-slate-600")" href="/PurchaseOrders">Purchase Orders</a>
                <a class="whitespace-nowrap rounded-full px-3 py-1.5 text-xs font-medium transition @(IsActive("/DeliveryChallans") ? "bg-sky-600 text-white shadow-sm shadow-sky-600/30" : "bg-slate-100 text-slate-600")" href="/DeliveryChallans">Delivery Challans</a>
                <a class="whitespace-nowrap rounded-full px-3 py-1.5 text-xs font-medium transition @(IsActive("/Billing") ? "bg-sky-600 text-white shadow-sm shadow-sky-600/30" : "bg-slate-100 text-slate-600")" href="/Billing">Billing</a>
                <a class="whitespace-nowrap rounded-full px-3 py-1.5 text-xs font-medium transition @(IsActive("/Quotes") ? "bg-sky-600 text-white shadow-sm shadow-sky-600/30" : "bg-slate-100 text-slate-600")" href="/Quotes">Quote Preparation</a>
            </nav>

            <main class="app-main flex-1 overflow-y-auto p-4 md:p-6">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
