@using MechSoft.Domain.Enums
@model QuoteStatus
@{
    string label = Model switch
    {
        QuoteStatus.Draft => "Draft",
        QuoteStatus.Sent => "Sent",
        QuoteStatus.Accepted => "Accepted",
        QuoteStatus.Rejected => "Rejected",
        _ => Model.ToString(),
    };
    string classes = Model switch
    {
        QuoteStatus.Draft => "bg-slate-50 text-slate-600 ring-slate-500/20",
        QuoteStatus.Sent => "bg-sky-50 text-sky-700 ring-sky-600/20",
        QuoteStatus.Accepted => "bg-emerald-50 text-emerald-700 ring-emerald-600/20",
        QuoteStatus.Rejected => "bg-red-50 text-red-700 ring-red-600/20",
        _ => "bg-slate-50 text-slate-700 ring-slate-600/20",
    };
}
<span class="inline-flex items-center rounded px-2 py-0.5 text-[11px] font-medium ring-1 ring-inset @classes">@label</span>
