@model StockStatus
@{
    string label = Model switch
    {
        StockStatus.InStock => "In Stock",
        StockStatus.LowStock => "Low Stock",
        StockStatus.OutOfStock => "Out of Stock",
        _ => Model.ToString(),
    };
    string classes = Model switch
    {
        StockStatus.InStock => "bg-emerald-50 text-emerald-700 ring-emerald-600/20",
        StockStatus.LowStock => "bg-amber-50 text-amber-700 ring-amber-600/20",
        StockStatus.OutOfStock => "bg-red-50 text-red-700 ring-red-600/20",
        _ => "bg-slate-50 text-slate-700 ring-slate-600/20",
    };
}
<span class="inline-flex items-center rounded px-2 py-0.5 text-[11px] font-medium ring-1 ring-inset @classes">@label</span>
