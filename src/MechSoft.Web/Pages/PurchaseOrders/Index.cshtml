@page "/PurchaseOrders"
@model MechSoft.Web.Pages.PurchaseOrders.IndexModel
@{
    ViewData["Title"] = "Purchase Orders";
}

<div class="space-y-4">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
            <h1 class="text-xl font-semibold text-slate-900">Purchase Orders</h1>
            <p class="text-sm text-slate-500">Inbound orders raised against vendors.</p>
        </div>
        <a href="/PurchaseOrders/Edit" class="rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-800">+ New Purchase Order</a>
    </div>

    <div class="rounded-lg border border-slate-200 bg-white overflow-hidden">
        <table class="min-w-full divide-y divide-slate-200 text-sm">
            <thead class="bg-slate-50 text-xs uppercase text-slate-500">
                <tr>
                    <th class="px-4 py-2 text-left">PO ID</th>
                    <th class="px-4 py-2 text-left">Vendor</th>
                    <th class="px-4 py-2 text-left">Date</th>
                    <th class="px-4 py-2 text-left">Line Items</th>
                    <th class="px-4 py-2 text-left">Value</th>
                    <th class="px-4 py-2"></th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @foreach (var po in Model.Orders)
                {
                    <tr class="hover:bg-slate-50">
                        <td class="px-4 py-2 font-medium text-slate-900">@po.Id</td>
                        <td class="px-4 py-2 text-slate-700">@po.VendorCompany</td>
                        <td class="px-4 py-2 text-slate-700">@po.PoDate.ToString("dd MMM yyyy")</td>
                        <td class="px-4 py-2 text-slate-700">@po.ItemCount</td>
                        <td class="px-4 py-2 text-slate-700">@CurrencyFormatter.Format(po.TotalValue)</td>
                        <td class="px-4 py-2 text-right">
                            <a href="/PurchaseOrders/Edit?id=@po.Id" class="text-sky-700 hover:underline">Open</a>
                        </td>
                    </tr>
                }
                @if (!Model.Orders.Any())
                {
                    <tr><td colspan="6" class="px-4 py-6 text-center text-slate-400">No purchase orders yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
