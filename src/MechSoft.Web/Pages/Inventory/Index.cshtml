@page "/Inventory"
@model MechSoft.Web.Pages.Inventory.IndexModel
@using MechSoft.Domain.Enums
@{
    ViewData["Title"] = "Inventory";
}

<div class="space-y-4">
    <div>
        <h1 class="text-xl font-semibold text-slate-900">Inventory</h1>
        <p class="text-sm text-slate-500">Stock levels for every part. Specifications and vendor contacts are on the Product Details page.</p>
    </div>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="rounded-md border border-emerald-200 bg-emerald-50 px-4 py-2 text-sm text-emerald-800">@Model.Message</div>
    }

    <!-- Summary -->
    <div class="grid grid-cols-2 gap-3 lg:grid-cols-5">
        <a href="/Inventory" class="rounded-lg border border-slate-200 bg-white p-4 hover:border-sky-300">
            <div class="text-xs text-slate-500">Total parts</div>
            <div class="text-2xl font-semibold text-slate-900">@Model.AllParts.Count</div>
        </a>
        <div class="rounded-lg border border-slate-200 bg-white p-4">
            <div class="text-xs text-slate-500">Units on hand</div>
            <div class="text-2xl font-semibold text-slate-900">@Model.TotalUnits.ToString("N0")</div>
        </div>
        <a href="@Url.Page("Index", new { search = Model.Search, status = StockStatus.InStock })" class="rounded-lg border border-slate-200 bg-white p-4 hover:border-emerald-300">
            <div class="text-xs text-slate-500">In stock</div>
            <div class="text-2xl font-semibold text-emerald-700">@Model.Count(StockStatus.InStock)</div>
        </a>
        <a href="@Url.Page("Index", new { search = Model.Search, status = StockStatus.LowStock })" class="rounded-lg border border-slate-200 bg-white p-4 hover:border-amber-300">
            <div class="text-xs text-slate-500">Low stock</div>
            <div class="text-2xl font-semibold text-amber-700">@Model.Count(StockStatus.LowStock)</div>
        </a>
        <a href="@Url.Page("Index", new { search = Model.Search, status = StockStatus.OutOfStock })" class="rounded-lg border border-slate-200 bg-white p-4 hover:border-red-300">
            <div class="text-xs text-slate-500">Out of stock</div>
            <div class="text-2xl font-semibold text-red-700">@Model.Count(StockStatus.OutOfStock)</div>
        </a>
    </div>

    <form method="get" class="flex flex-wrap gap-2">
        <input type="text" name="Search" value="@Model.Search" placeholder="Search by SKU, name, material or vendor..."
               class="w-full max-w-sm rounded-md border border-slate-200 px-3 py-2 text-sm focus:border-sky-500 focus:outline-none focus:ring-1 focus:ring-sky-500" />
        <select name="Status" class="rounded-md border border-slate-200 px-3 py-2 text-sm">
            <option value="" selected="@(Model.Status is null)">All statuses</option>
            <option value="@StockStatus.InStock" selected="@(Model.Status == StockStatus.InStock)">In Stock</option>
            <option value="@StockStatus.LowStock" selected="@(Model.Status == StockStatus.LowStock)">Low Stock</option>
            <option value="@StockStatus.OutOfStock" selected="@(Model.Status == StockStatus.OutOfStock)">Out of Stock</option>
        </select>
        <button type="submit" class="rounded-md border border-slate-200 px-3 py-2 text-sm text-slate-600 hover:bg-slate-50">Filter</button>
        @if (!string.IsNullOrWhiteSpace(Model.Search) || Model.Status is not null)
        {
            <a href="/Inventory" class="rounded-md px-3 py-2 text-sm text-slate-500 hover:underline">Clear</a>
        }
    </form>

    <div class="overflow-hidden rounded-lg border border-slate-200 bg-white">
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-slate-200 text-sm">
                <thead class="bg-slate-50 text-xs uppercase text-slate-500">
                    <tr>
                        <th class="px-3 py-2 text-left">SKU</th>
                        <th class="px-3 py-2 text-left">Name</th>
                        <th class="px-3 py-2 text-left">Category</th>
                        <th class="px-3 py-2 text-left">Status</th>
                        <th class="px-3 py-2 text-left">Update stock</th>
                        <th class="px-3 py-2 text-right"></th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var p in Model.Parts)
                    {
                        <tr class="hover:bg-slate-50">
                            <td class="px-3 py-2 font-medium text-slate-900">@p.Sku</td>
                            <td class="px-3 py-2 text-slate-700">@p.Name</td>
                            <td class="px-3 py-2 text-slate-500">@p.Category</td>
                            <td class="px-3 py-2"><partial name="_StockBadge" model="p.Status" /></td>
                            <td class="px-3 py-2">
                                <form method="post" asp-page-handler="UpdateStock" class="flex flex-wrap items-center gap-2">
                                    <input type="hidden" name="id" value="@p.Id" />
                                    <input type="hidden" name="search" value="@Model.Search" />
                                    <input type="hidden" name="filter" value="@Model.Status" />
                                    <input type="number" name="stock" min="0" value="@p.Stock" aria-label="Stock for @p.Sku" class="w-24 rounded-md border border-slate-200 px-2 py-1 text-right text-sm" />
                                    <select name="status" aria-label="Status for @p.Sku" class="rounded-md border border-slate-200 px-2 py-1 text-sm">
                                        <option value="@StockStatus.InStock" selected="@(p.Status == StockStatus.InStock)">In Stock</option>
                                        <option value="@StockStatus.LowStock" selected="@(p.Status == StockStatus.LowStock)">Low Stock</option>
                                        <option value="@StockStatus.OutOfStock" selected="@(p.Status == StockStatus.OutOfStock)">Out of Stock</option>
                                    </select>
                                    <button type="submit" class="rounded-md bg-slate-900 px-3 py-1 text-xs font-medium text-white hover:bg-slate-800">Save</button>
                                </form>
                            </td>
                            <td class="px-3 py-2 text-right"><a href="@Url.Page("/Products/Index", new { selectedId = p.Id })" class="text-xs text-sky-700 hover:underline">Details &amp; vendor &rarr;</a></td>
                        </tr>
                    }
                    @if (!Model.Parts.Any())
                    {
                        <tr><td colspan="6" class="px-3 py-8 text-center text-slate-400">No parts match your filters.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
