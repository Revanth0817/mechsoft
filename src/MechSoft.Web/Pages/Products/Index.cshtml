@page "/Products"
@model MechSoft.Web.Pages.Products.IndexModel
@{
    ViewData["Title"] = "Product Details";

    string IconFor(string label) => label switch
    {
        "Torque" => "&#9878;",       // gauge-ish
        "Voltage" => "&#9889;",      // zap
        "Weight" => "&#9878;",       // weight
        _ => "&#128207;",            // ruler/default
    };
}

<div class="space-y-4">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
            <h1 class="text-xl font-semibold text-slate-900">Product Details</h1>
            <p class="text-sm text-slate-500">Component specifications and vendor contact details. Stock levels are on the Inventory page.</p>
        </div>
        <button type="button" onclick="openNewPart()"
                class="rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-800">
            + New Part
        </button>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="rounded-md border border-red-200 bg-red-50 px-4 py-2 text-sm text-red-700">
            Could not save the part: @string.Join(" ", ViewData.ModelState.Values.SelectMany(v => v.Errors).Select(e => e.ErrorMessage))
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.PhotoMessage))
    {
        <div class="rounded-md border border-emerald-200 bg-emerald-50 px-4 py-2 text-sm text-emerald-800">@Model.PhotoMessage</div>
    }
    @if (!string.IsNullOrEmpty(Model.PhotoError))
    {
        <div class="rounded-md border border-red-200 bg-red-50 px-4 py-2 text-sm text-red-700">@Model.PhotoError</div>
    }

    <form method="get" class="flex gap-2">
        <input type="text" name="Search" value="@Model.Search" placeholder="Search by SKU, name, material or vendor..."
               class="w-full max-w-sm rounded-md border border-slate-200 px-3 py-2 text-sm focus:border-sky-500 focus:outline-none focus:ring-1 focus:ring-sky-500" />
        <button type="submit" class="rounded-md border border-slate-200 px-3 py-2 text-sm text-slate-600 hover:bg-slate-50">Search</button>
        @if (!string.IsNullOrWhiteSpace(Model.Search))
        {
            <a href="/Products" class="rounded-md px-3 py-2 text-sm text-slate-500 hover:underline">Clear</a>
        }
    </form>

    <div class="grid grid-cols-1 gap-4 lg:grid-cols-5">
        <!-- Left: parts table -->
        <div class="lg:col-span-2 rounded-lg border border-slate-200 bg-white overflow-hidden">
            <div class="max-h-[32rem] overflow-y-auto">
                <table class="min-w-full divide-y divide-slate-200 text-sm">
                    <thead class="sticky top-0 bg-slate-50 text-xs uppercase text-slate-500">
                        <tr>
                            <th class="px-3 py-2 text-left">SKU</th>
                            <th class="px-3 py-2 text-left">Name</th>
                            <th class="px-3 py-2 text-left">Category</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var p in Model.Parts)
                        {
                            var isSelected = Model.Selected?.Id == p.Id;
                            <tr class="cursor-pointer @(isSelected ? "bg-sky-50" : "hover:bg-slate-50")"
                                onclick="location.href='@Url.Page("Index", new { selectedId = p.Id, search = Model.Search })'">
                                <td class="px-3 py-2">
                                    <div class="flex items-center gap-2">
                                        @if (p.HasPhoto)
                                        {
                                            <img src="@Url.Page("Index", "Photo", new { id = p.Id })" alt="" class="h-7 w-7 shrink-0 rounded object-cover ring-1 ring-slate-200" />
                                        }
                                        else
                                        {
                                            <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded bg-slate-100 text-xs text-slate-400 ring-1 ring-slate-200">&#128247;</span>
                                        }
                                        <span class="font-medium text-slate-900">@p.Sku</span>
                                    </div>
                                </td>
                                <td class="px-3 py-2 text-slate-700">@p.Name</td>
                                <td class="px-3 py-2 text-slate-700">@p.Category</td>
                            </tr>
                        }
                        @if (!Model.Parts.Any())
                        {
                            <tr><td colspan="3" class="px-3 py-6 text-center text-slate-400">No parts match your search.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Right: detail pane -->
        <div class="lg:col-span-3 space-y-4">
            @if (Model.Selected is { } part)
            {
                <div class="rounded-lg border border-slate-200 bg-white p-4">
                    <div class="flex flex-wrap items-start justify-between gap-4">
                        <div class="flex items-start gap-4">
                            <div class="group relative h-20 w-20 shrink-0 overflow-hidden rounded-md border border-slate-200 bg-slate-50">
                                @if (part.HasPhoto)
                                {
                                    <img src="@Url.Page("Index", "Photo", new { id = part.Id })" alt="@part.Name" class="h-full w-full object-cover" />
                                }
                                else
                                {
                                    <div class="flex h-full w-full items-center justify-center text-2xl text-slate-300">&#128247;</div>
                                }
                                <form method="post" asp-page-handler="UploadPhoto" asp-route-id="@part.Id" enctype="multipart/form-data" class="absolute inset-0">
                                    <label class="flex h-full w-full cursor-pointer items-center justify-center bg-slate-900/0 text-[10px] font-medium text-transparent group-hover:bg-slate-900/50 group-hover:text-white">
                                        @(part.HasPhoto ? "Change" : "Add Photo")
                                        <input type="file" name="photo" accept="image/*" class="hidden" onchange="this.form.submit()" />
                                    </label>
                                </form>
                            </div>
                            <div>
                                <div class="text-xs text-slate-500">@part.Sku &middot; @part.Category</div>
                                <h2 class="text-lg font-semibold text-slate-900">@part.Name</h2>
                                <div class="text-sm text-slate-500">@part.Material</div>
                                @if (part.HasPhoto)
                                {
                                    <form method="post" asp-page-handler="RemovePhoto" asp-route-id="@part.Id" class="mt-1">
                                        <button type="submit" class="text-[11px] text-red-600 hover:underline">Remove photo</button>
                                    </form>
                                }
                            </div>
                        </div>
                        <div class="text-right">
                            <button type="button" onclick="openEditPart()" class="text-xs font-medium text-sky-700 hover:underline">Edit</button>
                            <div class="mt-1"><a href="/Inventory?search=@Uri.EscapeDataString(part.Sku)" class="text-xs text-slate-500 hover:underline">View stock in Inventory &rarr;</a></div>
                        </div>
                    </div>

                    <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3">
                        @foreach (var spec in part.Specs)
                        {
                            <div class="rounded-md border border-slate-200 p-3">
                                <div class="text-lg">@Html.Raw(IconFor(spec.Label))</div>
                                <div class="mt-1 text-xs text-slate-500">@spec.Label</div>
                                <div class="text-sm font-medium text-slate-900">@spec.Value</div>
                            </div>
                        }
                        @if (!part.Specs.Any())
                        {
                            <div class="col-span-full text-sm text-slate-400">No specifications recorded.</div>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(part.Notes))
                    {
                        <div class="mt-4 rounded-md bg-slate-50 p-3 text-sm text-slate-600">
                            <div class="mb-1 text-xs font-semibold uppercase text-slate-400">Notes</div>
                            @part.Notes
                        </div>
                    }
                </div>

                <div class="rounded-lg border border-slate-200 bg-white p-4">
                    <div class="mb-3 text-xs font-semibold uppercase text-slate-500">Vendor Details</div>
                    @if (string.IsNullOrWhiteSpace(part.VendorName) && string.IsNullOrWhiteSpace(part.VendorEmail) && string.IsNullOrWhiteSpace(part.VendorPhone) && string.IsNullOrWhiteSpace(part.VendorContactPerson))
                    {
                        <div class="text-sm text-slate-400">No vendor recorded for this product. Use Edit to add the vendor, email and contact number.</div>
                    }
                    else
                    {
                        <dl class="grid grid-cols-1 gap-3 text-sm sm:grid-cols-2">
                            <div>
                                <dt class="text-xs text-slate-500">Vendor</dt>
                                <dd class="font-medium text-slate-900">@(string.IsNullOrWhiteSpace(part.VendorName) ? "—" : part.VendorName)</dd>
                            </div>
                            <div>
                                <dt class="text-xs text-slate-500">Contact person</dt>
                                <dd class="text-slate-900">@(string.IsNullOrWhiteSpace(part.VendorContactPerson) ? "—" : part.VendorContactPerson)</dd>
                            </div>
                            <div>
                                <dt class="text-xs text-slate-500">Email</dt>
                                <dd>
                                    @if (string.IsNullOrWhiteSpace(part.VendorEmail)) { <span class="text-slate-900">—</span> }
                                    else { <a href="mailto:@part.VendorEmail" class="text-sky-700 hover:underline">@part.VendorEmail</a> }
                                </dd>
                            </div>
                            <div>
                                <dt class="text-xs text-slate-500">Contact number</dt>
                                <dd>
                                    @if (string.IsNullOrWhiteSpace(part.VendorPhone)) { <span class="text-slate-900">—</span> }
                                    else { <a href="tel:@part.VendorPhone.Replace(" ", "")" class="text-sky-700 hover:underline">@part.VendorPhone</a> }
                                </dd>
                            </div>
                        </dl>
                    }
                </div>

                <script type="application/json" id="selectedPartJson">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new
                {
                    id = part.Id,
                    sku = part.Sku,
                    name = part.Name,
                    material = part.Material,
                    category = part.Category,
                    stock = part.Stock,
                    status = (int)part.Status,
                    notes = part.Notes ?? string.Empty,
                    vendorName = part.VendorName,
                    vendorContactPerson = part.VendorContactPerson,
                    vendorEmail = part.VendorEmail,
                    vendorPhone = part.VendorPhone,
                    specs = part.Specs.Select(s => new { label = s.Label, value = s.Value }),
                }))</script>
            }
            else
            {
                <div class="rounded-lg border border-dashed border-slate-300 bg-white p-10 text-center text-sm text-slate-400">
                    Select a part to view its details.
                </div>
            }
        </div>
    </div>
</div>

<!-- New Part modal -->
<div id="newPartModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-slate-900/50 p-4">
    <div class="w-full max-w-2xl rounded-lg bg-white shadow-xl max-h-[90vh] overflow-y-auto">
        <form method="post" asp-page-handler="Save">
            <input type="hidden" asp-for="NewPart.Id" />
            <div class="flex items-center justify-between border-b border-slate-200 px-5 py-3">
                <h3 id="partModalTitle" class="text-sm font-semibold text-slate-900">New Part</h3>
                <button type="button" onclick="document.getElementById('newPartModal').classList.add('hidden')" class="text-slate-400 hover:text-slate-600">&#10005;</button>
            </div>
            <div class="space-y-3 px-5 py-4">
                <div class="grid grid-cols-2 gap-3">
                    <label class="block text-xs font-medium text-slate-600">SKU
                        <input asp-for="NewPart.Sku" class="mt-1 w-full rounded-md border border-slate-200 px-3 py-2 text-sm" />
                    </label>
                    <label class="block text-xs font-medium text-slate-600">Part Name
                        <input asp-for="NewPart.Name" class="mt-1 w-full rounded-md border border-slate-200 px-3 py-2 text-sm" />
                    </label>
                    <label class="block text-xs font-medium text-slate-600">Material
                        <input asp-for="NewPart.Material" class="mt-1 w-full rounded-md border border-slate-200 px-3 py-2 text-sm" />
                    </label>
                    <label class="block text-xs font-medium text-slate-600">Category
                        <input asp-for="NewPart.Category" class="mt-1 w-full rounded-md border border-slate-200 px-3 py-2 text-sm" />
                    </label>
                </div>
                <input asp-for="NewPart.Stock" type="hidden" />
                <input asp-for="NewPart.Status" type="hidden" />

                <div class="rounded-md border border-slate-200 p-3">
                    <div class="mb-2 text-xs font-semibold uppercase text-slate-500">Vendor Details</div>
                    <div class="grid grid-cols-2 gap-3">
                        <label class="block text-xs font-medium text-slate-600">Vendor Name
                            <input asp-for="NewPart.VendorName" class="mt-1 w-full rounded-md border border-slate-200 px-3 py-2 text-sm" />
                        </label>
                        <label class="block text-xs font-medium text-slate-600">Contact Person
                            <input asp-for="NewPart.VendorContactPerson" class="mt-1 w-full rounded-md border border-slate-200 px-3 py-2 text-sm" />
                        </label>
                        <label class="block text-xs font-medium text-slate-600">Vendor Email
                            <input asp-for="NewPart.VendorEmail" type="email" class="mt-1 w-full rounded-md border border-slate-200 px-3 py-2 text-sm" />
                        </label>
                        <label class="block text-xs font-medium text-slate-600">Contact Number
                            <input asp-for="NewPart.VendorPhone" type="tel" class="mt-1 w-full rounded-md border border-slate-200 px-3 py-2 text-sm" />
                        </label>
                    </div>
                </div>

                <div>
                    <div class="mb-1 flex items-center justify-between">
                        <span class="text-xs font-medium text-slate-600">Specifications</span>
                        <button type="button" id="addSpecRow" class="text-xs font-medium text-sky-700 hover:underline">+ Add spec</button>
                    </div>
                    <div id="specRows" class="space-y-2"></div>
                </div>

                <label class="block text-xs font-medium text-slate-600">Notes
                    <textarea asp-for="NewPart.Notes" rows="3" class="mt-1 w-full rounded-md border border-slate-200 px-3 py-2 text-sm"></textarea>
                </label>
            </div>
            <div class="flex justify-end gap-2 border-t border-slate-200 px-5 py-3">
                <button type="button" onclick="document.getElementById('newPartModal').classList.add('hidden')" class="rounded-md border border-slate-200 px-4 py-2 text-sm text-slate-600 hover:bg-slate-50">Cancel</button>
                <button type="submit" class="rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-800">Save Part</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    (function () {
        const rowsHost = document.getElementById('specRows');
        const modal = document.getElementById('newPartModal');
        const title = document.getElementById('partModalTitle');
        const fields = {
            id: document.getElementById('NewPart_Id'),
            sku: document.getElementById('NewPart_Sku'),
            name: document.getElementById('NewPart_Name'),
            material: document.getElementById('NewPart_Material'),
            category: document.getElementById('NewPart_Category'),
            stock: document.getElementById('NewPart_Stock'),
            status: document.getElementById('NewPart_Status'),
            notes: document.getElementById('NewPart_Notes'),
            vendorName: document.getElementById('NewPart_VendorName'),
            vendorContactPerson: document.getElementById('NewPart_VendorContactPerson'),
            vendorEmail: document.getElementById('NewPart_VendorEmail'),
            vendorPhone: document.getElementById('NewPart_VendorPhone'),
        };

        function addRow(label, value) {
            const idx = rowsHost.children.length;
            const row = document.createElement('div');
            row.className = 'flex gap-2';
            row.innerHTML = `
                <input name="NewPart.SpecLabels[${idx}]" value="${label ?? ''}" placeholder="Label" class="w-1/2 rounded-md border border-slate-200 px-3 py-1.5 text-sm" />
                <input name="NewPart.SpecValues[${idx}]" value="${value ?? ''}" placeholder="Value" class="w-1/2 rounded-md border border-slate-200 px-3 py-1.5 text-sm" />
                <button type="button" class="text-red-600 text-xs hover:underline" onclick="this.parentElement.remove()">Remove</button>
            `;
            rowsHost.appendChild(row);
        }

        function resetForm() {
            fields.id.value = '';
            fields.sku.value = '';
            fields.name.value = '';
            fields.material.value = '';
            fields.category.value = '';
            fields.stock.value = 0;
            fields.status.value = 2; // new parts start out of stock; set stock on the Inventory page
            fields.notes.value = '';
            fields.vendorName.value = '';
            fields.vendorContactPerson.value = '';
            fields.vendorEmail.value = '';
            fields.vendorPhone.value = '';
            rowsHost.innerHTML = '';
            addRow(); addRow();
        }

        window.openNewPart = function () {
            title.textContent = 'New Part';
            resetForm();
            modal.classList.remove('hidden');
        };

        window.openEditPart = function () {
            const el = document.getElementById('selectedPartJson');
            if (!el) return;
            const data = JSON.parse(el.textContent);

            title.textContent = 'Edit ' + data.sku;
            fields.id.value = data.id;
            fields.sku.value = data.sku;
            fields.name.value = data.name;
            fields.material.value = data.material;
            fields.category.value = data.category;
            fields.stock.value = data.stock;
            fields.status.value = data.status;
            fields.notes.value = data.notes;
            fields.vendorName.value = data.vendorName || '';
            fields.vendorContactPerson.value = data.vendorContactPerson || '';
            fields.vendorEmail.value = data.vendorEmail || '';
            fields.vendorPhone.value = data.vendorPhone || '';

            rowsHost.innerHTML = '';
            if (data.specs && data.specs.length) {
                data.specs.forEach(s => addRow(s.label, s.value));
            } else {
                addRow(); addRow();
            }

            modal.classList.remove('hidden');
        };

        document.getElementById('addSpecRow').addEventListener('click', () => addRow());
        addRow(); addRow();
    })();
</script>
}
